# Telegram (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard settings protection
FLASK_SECRET_KEY=
DASHBOARD_PASSWORD=
DASHBOARD_LOCAL_ONLY=1

# Cursor Premium (preferred LLM — uses your Cursor account usage)
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Optional model override for publishing agent (e.g. grok-4.5)
PUBLISHER_MODEL=

# Optional fallbacks if Cursor key missing
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: higher GitHub rate limits
GITHUB_TOKEN=

# Collection caps + freshness
MAX_ARXIV=12
MAX_GITHUB=12
MAX_REDDIT=12
MAX_RSS=12
MAX_FORUMS=12
MAX_HN=10
MAX_X=8
MAX_TOTAL_ITEMS=18
# Prefer signals from the last N hours (Istanbul day focus). Soft fallback to ~2x if sparse.
MAX_AGE_HOURS=36

# Timezone for report headers / "today"
REPORT_TZ=Europe/Istanbul
