# Telegram (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard settings protection
FLASK_SECRET_KEY=
DASHBOARD_PASSWORD=
DASHBOARD_LOCAL_ONLY=1

# Cursor Premium (preferred LLM — uses your Cursor account usage)
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Optional model override for publishing agent (e.g. grok-4.5)
PUBLISHER_MODEL=

# Optional fallbacks if Cursor key missing
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: higher GitHub rate limits
GITHUB_TOKEN=

# Collection caps
MAX_ARXIV=10
MAX_GITHUB=10
MAX_REDDIT=10
MAX_TOTAL_ITEMS=14

# Timezone for report headers
REPORT_TZ=Europe/Istanbul
